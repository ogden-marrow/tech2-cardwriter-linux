#!/usr/bin/env python3
"""Launcher for Tech2 Card Writer."""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(HERE)

# Source checkout fallback: ./bin/tech2-cardwriter with ./src/tech2_cardwriter
for lib in (os.path.join(ROOT, "lib"), os.path.join(ROOT, "src")):
    if os.path.isdir(os.path.join(lib, "tech2_cardwriter")):
        sys.path.insert(0, lib)
        break

os.environ.setdefault("TECH2_CARDWRITER_ROOT", ROOT)
from tech2_cardwriter.cli import main

raise SystemExit(main())
